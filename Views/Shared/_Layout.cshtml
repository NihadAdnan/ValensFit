<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ValensFit</title>
    <meta name="description" content="Personalized 7-day diet and workout plan generator with localized grocery price grounding." />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Stylesheet -->
    <link rel="stylesheet" href="~/css/roman-theme.css" asp-append-version="true" />
</head>
<body>
    <!-- Navigation Bar -->
    <header class="app-nav">
        <a href="/" class="brand-logo">
            <div class="brand-monogram">
                V
            </div>
            <div>
                <div class="brand-title">Valens<span class="brand-accent-text">Fit</span></div>
                <div class="brand-tagline-nav">Nutrition & Training Architecture</div>
            </div>
        </a>
    </header>

    <!-- Main Container -->
    <main role="main" class="app-container">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="no-print" style="text-align: center; padding: 2rem 1rem; border-top: 1px solid var(--border-subtle); color: var(--text-muted); font-size: 0.8rem;">
        <p style="margin-bottom: 0.35rem;">
            ValensFit · Formulated with Mifflin-St Jeor Sports Nutrition Formulas.
        </p>
        <p style="color: var(--text-muted); font-size: 0.75rem;">
            General wellness tool. Not medical advice. Consult a healthcare professional for personalized medical or clinical dietary needs.
        </p>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
