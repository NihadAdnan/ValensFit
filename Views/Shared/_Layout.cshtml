<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ValensFit</title>
    <meta name="description" content="Personalized Dhaka 7-day diet generator, workout routines, and daily food calorie tracker with localized cooking oil analysis." />

    <!-- Roman Laurel Favicon (Matching Header Icon) -->
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Stylesheet -->
    <link rel="stylesheet" href="~/css/roman-theme.css" asp-append-version="true" />

    <!-- Instant Theme Initializer (Prevents Theme Flash) -->
    <script>
        (function() {
            var savedTheme = localStorage.getItem('valensfit_theme') || 'dark';
            document.documentElement.setAttribute('data-theme', savedTheme);
        })();
    </script>
</head>
<body>
    <!-- Navigation Bar -->
    <header class="app-nav">
        <a href="/" class="brand-logo">
            <div class="brand-monogram">
                <img src="~/favicon.svg" alt="ValensFit Roman Laurel" width="36" height="36" style="display: block; border-radius: var(--radius-sm);" />
            </div>
            <div>
                <div class="brand-title">Valens<span class="brand-accent-text">Fit</span></div>
                <div class="brand-tagline-nav">Dhaka Nutrition & Training Architecture</div>
            </div>
        </a>

        <!-- Desktop Navigation Links -->
        <nav class="nav-links no-print">
            <a href="/" class="nav-link">Home</a>
            <a href="/Plan/Diet" class="nav-link">🥗 Diet Plan</a>
            <a href="/Plan/Workout" class="nav-link">🏋️ Workout</a>
            <a href="/Plan/Tracker" class="nav-link">🔢 Food Tracker</a>
        </nav>

        <!-- Top Right Theme Switcher: Dark mode shows Sun (☀️), Light mode shows Moon (🌙) -->
        <div class="nav-actions">
            <button type="button" id="themeToggleBtn" class="theme-toggle-btn" onclick="toggleTheme()" title="Switch Theme" aria-label="Switch Theme">
                <span id="themeIcon">☀️</span>
            </button>
        </div>
    </header>

    <!-- Main Container -->
    <main role="main" class="app-container">
        @RenderBody()
    </main>

    <!-- Sticky Footer (Anchors to Bottom of Widescreen) -->
    <footer class="app-footer no-print">
        <p style="margin-bottom: 0.25rem;">
            ValensFit · Formulated with Mifflin-St Jeor Sports Nutrition Formulas & Dhaka Market Index.
        </p>
        <p style="color: var(--text-muted); font-size: 0.74rem;">
            General wellness tool for Dhaka, Bangladesh. Not medical advice. Consult a healthcare professional for clinical dietary needs.
        </p>
    </footer>

    <!-- Global Theme Toggle Script -->
    <script>
        function updateThemeIcon(theme) {
            var iconEl = document.getElementById('themeIcon');
            if (iconEl) {
                // In Dark mode show Sun (☀️) to switch to light, in Light mode show Moon (🌙) to switch to dark
                iconEl.textContent = (theme === 'dark') ? '☀️' : '🌙';
            }
        }

        function toggleTheme() {
            var currentTheme = document.documentElement.getAttribute('data-theme') || 'dark';
            var newTheme = (currentTheme === 'dark') ? 'light' : 'dark';
            document.documentElement.setAttribute('data-theme', newTheme);
            localStorage.setItem('valensfit_theme', newTheme);
            updateThemeIcon(newTheme);
        }

        document.addEventListener('DOMContentLoaded', function() {
            var theme = document.documentElement.getAttribute('data-theme') || 'dark';
            updateThemeIcon(theme);
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
