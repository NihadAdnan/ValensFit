<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ValensFit | Strength, Discipline, Vitality</title>
    <meta name="description" content="ValensFit is a free, no-login personalized 7-day diet and fitness plan generator. Deterministic sports nutrition + AI budget grounding." />

    <!-- Google Fonts: Cinzel & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Roman Theme CSS -->
    <link rel="stylesheet" href="~/css/roman-theme.css" asp-append-version="true" />
</head>
<body>
    <!-- Roman Imperial Navigation Bar -->
    <header class="roman-nav">
        <a href="/" class="brand-logo">
            <div class="brand-monogram">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 3 L12 19 L18 3"></path>
                    <path d="M4 10 C3 14, 5 18, 12 21 C19 18, 21 14, 20 10"></path>
                </svg>
            </div>
            <div>
                <div class="brand-title">VALENS<span class="gold-text">FIT</span></div>
                <div class="brand-tagline-nav">Strength · Discipline · Vitality</div>
            </div>
        </a>

        <div class="nav-badge-pill no-print">
            <span style="color: var(--gold-primary);">✦</span>
            <span>100% Free · No Sign-up · In-Memory</span>
        </div>
    </header>

    <!-- Main App Container -->
    <main role="main" class="app-container">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="no-print" style="text-align: center; padding: 2.5rem 1rem; border-top: 1px solid var(--border-subtle); color: var(--text-muted); font-size: 0.82rem;">
        <div class="column-divider" style="max-width: 300px; margin: 0 auto 1.5rem auto;">
            <div class="line"></div>
            <div class="laurel-icon">❖</div>
            <div class="line"></div>
        </div>
        <p style="margin-bottom: 0.5rem;">
            <strong class="font-roman" style="color: var(--gold-antique); letter-spacing: 0.08em;">VALENSFIT IMPERIAL EDITION</strong> — Formulated with Mifflin-St Jeor & AI Local Price Grounding.
        </p>
        <p style="color: var(--text-muted); font-size: 0.76rem;">
            Guest Session Guarantee: No credentials stored. Computations reside solely in volatile memory. Not medical advice.
        </p>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
