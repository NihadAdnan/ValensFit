@model ValensFit.Models.UserInputModel
@{
    ViewData["Title"] = "Personalized Nutrition & Fitness Plan";
}

<div class="clean-card" id="wizardContainer">
    <!-- Wizard Progress Tracker -->
    <div class="wizard-progress-bar no-print" id="progressBarSection" style="display: none;">
        <div class="progress-track"></div>
        <div class="progress-fill" id="progressFill" style="width: 0%;"></div>
        
        <div class="step-node active" data-step="1" title="Identity">1</div>
        <div class="step-node" data-step="2" title="Biometrics">2</div>
        <div class="step-node" data-step="3" title="Nutrition & Budget">3</div>
        <div class="step-node" data-step="4" title="Training">4</div>
    </div>

    <!-- Hidden Form Elements for Submission -->
    <form id="planForm" method="post" action="/Plan/Generate">
        
        <!-- =================================================================
             STEP 0: INTRO & SAMPLE PROFILES
             ================================================================= -->
        <div class="wizard-step active" id="step0">
            <div style="text-align: center; padding: 1rem 0;">
                <h1 style="font-size: 2.3rem; margin: 0.5rem 0; line-height: 1.25;">
                    Personalized Diet & Training Plan Generator
                </h1>
                
                <p style="font-size: 1.05rem; color: var(--text-secondary); max-width: 620px; margin: 0 auto 1.5rem auto;">
                    Generate a deterministic 7-day meal schedule tailored to your goals, localized grocery budget estimates, and a structured workout routine.
                </p>

                <div style="display: flex; justify-content: center; margin-bottom: 2rem;">
                    <button type="button" class="btn-primary" onclick="Wizard.goToStep(1)" style="font-size: 1rem; padding: 0.9rem 2.25rem;">
                        <span>Get Started</span>
                        <span>➔</span>
                    </button>
                </div>

                <div class="section-divider" style="max-width: 500px; margin: 1.5rem auto 1rem;">
                    <div class="line"></div>
                    <div class="icon">Quick Load Example Profiles</div>
                    <div class="line"></div>
                </div>

                <!-- Subtle Sample Profile Chips (No Ad/Course Vibe) -->
                <div class="sample-presets-bar" style="justify-content: center;">
                    <div class="sample-chip" onclick="Wizard.loadPreset('student_cut')">
                        📍 Dhaka Student Budget (BDT 7,000 / 4-Day Gym)
                    </div>
                    <div class="sample-chip" onclick="Wizard.loadPreset('hypertrophy')">
                        📍 High Protein Hypertrophy ($350 / 5-Day Split)
                    </div>
                    <div class="sample-chip" onclick="Wizard.loadPreset('home_fit')">
                        📍 Vegetarian Home Calisthenics (£200 / 3-Day)
                    </div>
                </div>
            </div>
        </div>

        <!-- =================================================================
             STEP 1: IDENTITY (First Name)
             ================================================================= -->
        <div class="wizard-step" id="step1" style="display: none;">
            <div class="section-divider">
                <div class="line"></div>
                <div class="icon">Step 1 of 4 · Profile</div>
                <div class="line"></div>
            </div>

            <h2 style="font-size: 1.6rem; text-align: center; margin-bottom: 0.4rem;">What is your first name?</h2>
            <p style="text-align: center; color: var(--text-muted); font-size: 0.88rem; margin-bottom: 2rem;">
                Used solely to address your plan report.
            </p>

            <div style="max-width: 440px; margin: 0 auto;">
                <div class="form-group">
                    <label class="form-label" for="FirstName">First Name</label>
                    <input type="text" id="FirstName" name="FirstName" class="form-input" value="" placeholder="e.g. Rafi" required />
                </div>
            </div>

            <div class="wizard-footer">
                <button type="button" class="btn-secondary" onclick="Wizard.goToStep(0)">
                    <span>Back</span>
                </button>
                <button type="button" class="btn-primary" onclick="Wizard.validateStep1()">
                    <span>Continue</span>
                    <span>➔</span>
                </button>
            </div>
        </div>

        <!-- =================================================================
             STEP 2: BIOMETRICS & GOAL
             ================================================================= -->
        <div class="wizard-step" id="step2" style="display: none;">
            <div class="section-divider">
                <div class="line"></div>
                <div class="icon">Step 2 of 4 · Biometrics & Goals</div>
                <div class="line"></div>
            </div>

            <h2 style="font-size: 1.6rem; text-align: center; margin-bottom: 0.4rem;">Biometric & Goal Assessment</h2>
            <p style="text-align: center; color: var(--text-muted); font-size: 0.88rem; margin-bottom: 2rem;">
                Calculates your Basal Metabolic Rate (BMR) and daily energy expenditure.
            </p>

            <!-- Biological Sex (Male / Female only) -->
            <label class="form-label">Biological Sex</label>
            <input type="hidden" id="Gender" name="Gender" value="@Model.Gender" />
            <div class="card-selector-grid" style="grid-template-columns: 1fr 1fr; margin-bottom: 1.75rem;">
                <div class="select-card @(Model.Gender == "Male" ? "selected" : "")" onclick="Wizard.setGender('Male', this)">
                    <div class="select-card-title">Male</div>
                    <div class="select-card-desc">BMR Formula: 10w + 6.25h - 5a + 5</div>
                </div>
                <div class="select-card @(Model.Gender == "Female" ? "selected" : "")" onclick="Wizard.setGender('Female', this)">
                    <div class="select-card-title">Female</div>
                    <div class="select-card-desc">BMR Formula: 10w + 6.25h - 5a - 161</div>
                </div>
            </div>

            <!-- Neatly Aligned Biometrics Row (Age, Height, Weight) -->
            <div class="biometrics-row">
                <!-- Age Column -->
                <div class="form-group">
                    <div class="input-header-row">
                        <label class="form-label" for="Age" style="margin-bottom: 0;">Age (Years)</label>
                    </div>
                    <input type="number" id="Age" name="Age" class="form-input" min="13" max="80" value="@Model.Age" required />
                    <small id="ageDisclaimer" style="color: var(--accent-amber); font-size: 0.75rem; display: none; margin-top: 0.3rem;">
                        Under-18: Conservative deficit safeguards applied.
                    </small>
                </div>

                <!-- Height Column -->
                <div class="form-group">
                    <div class="input-header-row">
                        <label class="form-label" style="margin-bottom: 0;">Height</label>
                        <div class="unit-toggle-group">
                            <button type="button" class="unit-toggle-btn active" id="btnHeightCm" onclick="Wizard.setHeightUnit('cm')">cm</button>
                            <button type="button" class="unit-toggle-btn" id="btnHeightFt" onclick="Wizard.setHeightUnit('ft')">ft/in</button>
                        </div>
                    </div>
                    <input type="hidden" id="HeightUnit" name="HeightUnit" value="cm" />
                    <div id="heightCmGroup">
                        <input type="number" id="Height" name="Height" class="form-input" min="120" max="230" step="0.5" value="@Model.Height" />
                    </div>
                    <div id="heightFtGroup" style="display: none; gap: 0.5rem;">
                        <input type="number" id="HeightFt" class="form-input" placeholder="Feet" min="4" max="7" value="5" />
                        <input type="number" id="HeightInches" name="HeightInches" class="form-input" placeholder="Inches" min="0" max="11" value="9" />
                    </div>
                </div>

                <!-- Weight Column -->
                <div class="form-group">
                    <div class="input-header-row">
                        <label class="form-label" style="margin-bottom: 0;">Weight</label>
                        <div class="unit-toggle-group">
                            <button type="button" class="unit-toggle-btn active" id="btnWeightKg" onclick="Wizard.setWeightUnit('kg')">kg</button>
                            <button type="button" class="unit-toggle-btn" id="btnWeightLb" onclick="Wizard.setWeightUnit('lb')">lbs</button>
                        </div>
                    </div>
                    <input type="hidden" id="WeightUnit" name="WeightUnit" value="kg" />
                    <input type="number" id="Weight" name="Weight" class="form-input" min="30" max="250" step="0.5" value="@Model.Weight" />
                </div>
            </div>

            <!-- Activity Level Cards -->
            <label class="form-label" style="margin-top: 0.5rem;">Daily Lifestyle & Activity</label>
            <input type="hidden" id="ActivityLevel" name="ActivityLevel" value="@Model.ActivityLevel" />
            <div class="card-selector-grid">
                <div class="select-card @(Model.ActivityLevel == "Sedentary" ? "selected" : "")" onclick="Wizard.setActivity('Sedentary', this)">
                    <div class="select-card-title">Sedentary (1.2×)</div>
                    <div class="select-card-desc">Desk job, little/no structured workout.</div>
                </div>
                <div class="select-card @(Model.ActivityLevel == "LightlyActive" ? "selected" : "")" onclick="Wizard.setActivity('LightlyActive', this)">
                    <div class="select-card-title">Lightly Active (1.375×)</div>
                    <div class="select-card-desc">Light workouts 1–3 days/week.</div>
                </div>
                <div class="select-card @(Model.ActivityLevel == "ModeratelyActive" ? "selected" : "")" onclick="Wizard.setActivity('ModeratelyActive', this)">
                    <div class="select-card-title">Moderately Active (1.55×)</div>
                    <div class="select-card-desc">Moderate workouts 3–5 days/week.</div>
                </div>
                <div class="select-card @(Model.ActivityLevel == "VeryActive" ? "selected" : "")" onclick="Wizard.setActivity('VeryActive', this)">
                    <div class="select-card-title">Very Active (1.725×)</div>
                    <div class="select-card-desc">Intense training 6–7 days/week.</div>
                </div>
            </div>

            <!-- Primary Goal Cards -->
            <label class="form-label" style="margin-top: 1rem;">Primary Fitness Goal</label>
            <input type="hidden" id="Goal" name="Goal" value="@Model.Goal" />
            <div class="card-selector-grid" style="grid-template-columns: repeat(3, 1fr);">
                <div class="select-card @(Model.Goal == "LoseFat" ? "selected" : "")" onclick="Wizard.setGoal('LoseFat', this)">
                    <div class="select-card-title">Lose Body Fat</div>
                    <div class="select-card-desc">Caloric deficit with high protein to protect lean mass.</div>
                </div>
                <div class="select-card @(Model.Goal == "Maintain" ? "selected" : "")" onclick="Wizard.setGoal('Maintain', this)">
                    <div class="select-card-title">Maintain / Recomp</div>
                    <div class="select-card-desc">Match maintenance calories for steady body composition.</div>
                </div>
                <div class="select-card @(Model.Goal == "BuildMuscle" ? "selected" : "")" onclick="Wizard.setGoal('BuildMuscle', this)">
                    <div class="select-card-title">Build Lean Muscle</div>
                    <div class="select-card-desc">Controlled lean surplus (+10–12%) for hypertrophy.</div>
                </div>
            </div>

            <!-- Muscle Retention Preference -->
            <div style="background: var(--bg-card); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); padding: 0.9rem 1.15rem; margin-top: 1.25rem; display: flex; align-items: center; justify-content: space-between;">
                <div>
                    <div style="font-weight: 700; font-size: 0.92rem; color: var(--text-primary);">Protect Muscle Mass (High Protein Focus)</div>
                    <div style="font-size: 0.8rem; color: var(--text-muted);">Allocates 2.2 g/kg protein to prevent muscle loss while losing weight or building lean tissue.</div>
                </div>
                <input type="checkbox" id="MaximizeMuscleRetention" name="MaximizeMuscleRetention" value="true" checked style="width: 18px; height: 18px; accent-color: var(--accent-primary);" />
            </div>

            <!-- Optional Pace Sanity Check Fields (Shown for LoseFat) -->
            <div id="fatLossPaceSection" style="background: rgba(255,255,255,0.02); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); padding: 1rem 1.25rem; margin-top: 1rem;">
                <div style="font-size: 0.82rem; font-weight: 700; color: var(--accent-secondary); margin-bottom: 0.5rem; text-transform: uppercase;">
                    Target Pace Validation (Optional)
                </div>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                    <div>
                        <label class="form-label" style="font-size: 0.75rem;">Target Weight Loss (kg)</label>
                        <input type="number" id="TargetWeightLossKg" name="TargetWeightLossKg" class="form-input" placeholder="e.g. 5" min="1" max="50" step="0.5" value="@Model.TargetWeightLossKg" />
                    </div>
                    <div>
                        <label class="form-label" style="font-size: 0.75rem;">Timeframe (Weeks)</label>
                        <input type="number" id="TimeframeWeeks" name="TimeframeWeeks" class="form-input" placeholder="e.g. 8" min="2" max="52" value="@Model.TimeframeWeeks" />
                    </div>
                </div>
            </div>

            <div class="wizard-footer">
                <button type="button" class="btn-secondary" onclick="Wizard.goToStep(1)">
                    <span>Back</span>
                </button>
                <button type="button" class="btn-primary" onclick="Wizard.validateStep2()">
                    <span>Continue</span>
                    <span>➔</span>
                </button>
            </div>
        </div>

        <!-- =================================================================
             STEP 3: LOCATION, BUDGET & MEAL CUSTOMIZATION
             ================================================================= -->
        <div class="wizard-step" id="step3" style="display: none;">
            <div class="section-divider">
                <div class="line"></div>
                <div class="icon">Step 3 of 4 · Nutrition & Budget</div>
                <div class="line"></div>
            </div>

            <h2 style="font-size: 1.6rem; text-align: center; margin-bottom: 0.4rem;">Location, Budget & Diet Structure</h2>
            <p style="text-align: center; color: var(--text-muted); font-size: 0.88rem; margin-bottom: 2rem;">
                Grounds your food recommendations and grocery costs to local market staples.
            </p>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.25rem;">
                <div class="form-group">
                    <label class="form-label" for="Country">Country</label>
                    <select id="Country" name="Country" class="form-select" onchange="Wizard.onCountryChange(this.value)">
                        <option value="Bangladesh" selected>Bangladesh</option>
                        <option value="United States">United States</option>
                        <option value="India">India</option>
                        <option value="United Kingdom">United Kingdom</option>
                        <option value="European Union">European Union</option>
                        <option value="Canada">Canada</option>
                        <option value="Australia">Australia</option>
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label" for="CityRegion">City / Region (Optional)</label>
                    <input type="text" id="CityRegion" name="CityRegion" class="form-input" value="@Model.CityRegion" placeholder="e.g. Dhaka, Chittagong, Sylhet" />
                </div>

                <div class="form-group">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.45rem;">
                        <label class="form-label" style="margin-bottom: 0;">Monthly Grocery Budget</label>
                        <span id="currencyLabel" style="color: var(--accent-primary); font-weight: 700; font-size: 0.8rem;">BDT (৳)</span>
                    </div>
                    <input type="hidden" id="Currency" name="Currency" value="@Model.Currency" />
                    <input type="number" id="MonthlyBudget" name="MonthlyBudget" class="form-input" value="@Model.MonthlyBudget" placeholder="e.g. 7000" min="0" />
                </div>
            </div>

            <!-- Breakfast & Meal Structure Preference -->
            <div class="form-group" style="margin-top: 0.5rem;">
                <label class="form-label">Breakfast Sizing Preference</label>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
                    <div class="select-card @(Model.MealStructure == "Standard" ? "selected" : "")" id="structStandard" onclick="Wizard.setMealStructure('Standard', this)" style="padding: 1rem; text-align: left;">
                        <div class="select-card-title" style="font-size: 0.92rem;">Standard Breakfast (Balanced)</div>
                        <div class="select-card-desc">Even 3-meal split (~30% breakfast, 35% lunch, 35% dinner).</div>
                    </div>
                    <div class="select-card @(Model.MealStructure == "LightBreakfast" ? "selected" : "")" id="structLight" onclick="Wizard.setMealStructure('LightBreakfast', this)" style="padding: 1rem; text-align: left;">
                        <div class="select-card-title" style="font-size: 0.92rem;">Light Breakfast (e.g. 2 Eggs)</div>
                        <div class="select-card-desc">Light morning meal; remaining calories moved to fuller lunch and dinner.</div>
                    </div>
                </div>
                <input type="hidden" id="MealStructure" name="MealStructure" value="@Model.MealStructure" />
            </div>

            <!-- Office / Outside Lunch Mode with Specific Input -->
            <div style="background: var(--bg-card); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); padding: 1.15rem; margin-bottom: 1.25rem;">
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.5rem;">
                    <div>
                        <div style="font-weight: 700; font-size: 0.92rem; color: var(--text-primary);">Office / Outside Lunch Mode</div>
                        <div style="font-size: 0.8rem; color: var(--text-muted);">Enable if you usually eat lunch at an office cafeteria or outside.</div>
                    </div>
                    <input type="checkbox" id="OfficeLunch" name="OfficeLunch" value="true" onchange="Wizard.toggleOfficeLunch(this.checked)" style="width: 18px; height: 18px; accent-color: var(--accent-primary);" />
                </div>
                
                <div id="officeLunchDetail" style="display: none; margin-top: 0.75rem; border-top: 1px solid var(--border-subtle); padding-top: 0.75rem;">
                    <label class="form-label" for="OfficeLunchDescription" style="font-size: 0.75rem;">What do you usually eat for outside lunch?</label>
                    <input type="text" id="OfficeLunchDescription" name="OfficeLunchDescription" class="form-input" placeholder="e.g. Steamed rice with chicken curry (1 piece), or Roti with dal" value="@Model.OfficeLunchDescription" />
                </div>
            </div>

            <!-- Dietary Guidelines & Restriction Tags -->
            <label class="form-label">Dietary Preferences & Guidelines</label>
            <div class="tags-cloud" id="dietTagsCloud">
                <div class="diet-tag active" data-tag="Halal" onclick="Wizard.toggleDietTag(this, 'Halal')">Halal</div>
                <div class="diet-tag active" data-tag="Egg + Chicken Only" onclick="Wizard.toggleDietTag(this, 'Egg + Chicken Only')">Egg + Chicken Only</div>
                <div class="diet-tag" data-tag="Vegetarian" onclick="Wizard.toggleDietTag(this, 'Vegetarian')">Vegetarian</div>
                <div class="diet-tag" data-tag="Vegan" onclick="Wizard.toggleDietTag(this, 'Vegan')">Vegan</div>
                <div class="diet-tag" data-tag="No beef" onclick="Wizard.toggleDietTag(this, 'No beef')">No Beef</div>
                <div class="diet-tag" data-tag="No pork" onclick="Wizard.toggleDietTag(this, 'No pork')">No Pork</div>
                <div class="diet-tag" data-tag="No fish" onclick="Wizard.toggleDietTag(this, 'No fish')">No Fish</div>
                <div class="diet-tag" data-tag="Lactose Free" onclick="Wizard.toggleDietTag(this, 'Lactose Free')">Dairy / Lactose Free</div>
                <div class="diet-tag" data-tag="Gluten Free" onclick="Wizard.toggleDietTag(this, 'Gluten Free')">Gluten Free</div>
                <div class="diet-tag" data-tag="Nut Free" onclick="Wizard.toggleDietTag(this, 'Nut Free')">Nut Free</div>
            </div>

            <!-- Free text exclusions -->
            <div class="form-group" style="margin-top: 1rem;">
                <label class="form-label" for="CustomRestrictions">Custom Food Exclusions or Allergies</label>
                <input type="text" id="CustomRestrictions" name="CustomRestrictions" class="form-input" placeholder="e.g. shrimp, peanuts, mushrooms" value="@Model.CustomRestrictions" />
            </div>

            <div class="wizard-footer">
                <button type="button" class="btn-secondary" onclick="Wizard.goToStep(2)">
                    <span>Back</span>
                </button>
                <button type="button" class="btn-primary" onclick="Wizard.validateStep3()">
                    <span>Continue</span>
                    <span>➔</span>
                </button>
            </div>
        </div>

        <!-- =================================================================
             STEP 4: TRAINING & EXERCISE REGIMENT
             ================================================================= -->
        <div class="wizard-step" id="step4" style="display: none;">
            <div class="section-divider">
                <div class="line"></div>
                <div class="icon">Step 4 of 4 · Training Routine</div>
                <div class="line"></div>
            </div>

            <h2 style="font-size: 1.6rem; text-align: center; margin-bottom: 0.4rem;">Physical Training Structure</h2>
            <p style="text-align: center; color: var(--text-muted); font-size: 0.88rem; margin-bottom: 2rem;">
                Choose your workout environment and schedule.
            </p>

            <!-- Exercise Preference Cards -->
            <label class="form-label">Training Modality</label>
            <input type="hidden" id="ExercisePreference" name="ExercisePreference" value="@Model.ExercisePreference" />
            <div class="card-selector-grid">
                <div class="select-card @(Model.ExercisePreference == "Gym" ? "selected" : "")" onclick="Wizard.setExercise('Gym', this)">
                    <div class="select-card-title">Gym Resistance</div>
                    <div class="select-card-desc">Barbells, dumbbells & cables for hypertrophy.</div>
                </div>
                <div class="select-card @(Model.ExercisePreference == "HomeBodyweight" ? "selected" : "")" onclick="Wizard.setExercise('HomeBodyweight', this)">
                    <div class="select-card-title">Home Bodyweight</div>
                    <div class="select-card-desc">Calisthenics routines with regressions.</div>
                </div>
                <div class="select-card @(Model.ExercisePreference == "WalkingOnly" ? "selected" : "")" onclick="Wizard.setExercise('WalkingOnly', this)">
                    <div class="select-card-title">Walking Protocol</div>
                    <div class="select-card-desc">Daily structured step targets for joint-friendly fat loss.</div>
                </div>
                <div class="select-card @(Model.ExercisePreference == "NoExercise" ? "selected" : "")" onclick="Wizard.setExercise('NoExercise', this)">
                    <div class="select-card-title">Diet Only</div>
                    <div class="select-card-desc">Nutritional deficit with daily baseline walking.</div>
                </div>
            </div>

            <!-- Conditional Steps Target Section (for Walking / General) -->
            <div id="walkingStepsSection" style="background: var(--bg-card); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); padding: 1.15rem; margin-top: 1.25rem;">
                <label class="form-label" for="DailyStepsTarget">Target Daily Steps Goal</label>
                <select id="DailyStepsTarget" name="DailyStepsTarget" class="form-select">
                    <option value="6000">6,000 Steps / Day (Moderate Baseline)</option>
                    <option value="8000">8,000 Steps / Day (Healthy Active)</option>
                    <option value="10000" selected>10,000 Steps / Day (Optimal Fat Loss & Cardio)</option>
                    <option value="12000">12,000 Steps / Day (High Activity)</option>
                    <option value="15000">15,000 Steps / Day (Intense Conditioning)</option>
                </select>
            </div>

            <!-- Schedule & Session duration -->
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.25rem; margin-top: 1.25rem;">
                <div class="form-group">
                    <label class="form-label" for="DaysPerWeek">Training Days Per Week</label>
                    <select id="DaysPerWeek" name="DaysPerWeek" class="form-select">
                        <option value="3">3 Days / Week (Full Body)</option>
                        <option value="4" selected>4 Days / Week (Upper / Lower)</option>
                        <option value="5">5 Days / Week (Push / Pull / Legs)</option>
                        <option value="6">6 Days / Week (High Frequency)</option>
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label" for="MinutesPerSession">Minutes Per Session</label>
                    <select id="MinutesPerSession" name="MinutesPerSession" class="form-select">
                        <option value="30">30 Minutes (Concise)</option>
                        <option value="45" selected>45 Minutes (Balanced)</option>
                        <option value="60">60 Minutes (Full Volume)</option>
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label" for="ExperienceLevel">Experience Level</label>
                    <select id="ExperienceLevel" name="ExperienceLevel" class="form-select">
                        <option value="Beginner" selected>Beginner (Form & Base)</option>
                        <option value="Intermediate">Intermediate (Overload)</option>
                        <option value="Advanced">Advanced (High Intensity)</option>
                    </select>
                </div>
            </div>

            <div class="wizard-footer">
                <button type="button" class="btn-secondary" onclick="Wizard.goToStep(3)">
                    <span>Back</span>
                </button>
                <button type="button" class="btn-primary" onclick="Wizard.submitAndGenerate()">
                    <span>Generate My Plan</span>
                    <span>➔</span>
                </button>
            </div>
        </div>

        <!-- =================================================================
             STEP 5: GENERATING ANIMATED STATE
             ================================================================= -->
        <div class="wizard-step" id="step5" style="display: none;">
            <div class="spinner-container">
                <div class="clean-spinner"></div>
                <h2 style="font-size: 1.75rem; margin-bottom: 0.4rem;">
                    Generating Your Plan
