@model ValensFit.Models.PlanResultModel
@{
    ViewData["Title"] = $"{Model.FirstName}'s Nutrition & Training Plan";
}

<!-- Master Results Container -->
<div class="clean-card" id="resultsContainer" style="margin-bottom: 2rem;">

    <!-- Top Action Bar -->
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.5rem;" class="no-print">
        <a href="/Plan" class="btn-secondary" style="font-size: 0.82rem; padding: 0.45rem 1rem;">
            <span>↺ Start Over</span>
        </a>
        <button type="button" class="btn-primary" onclick="window.print()" style="font-size: 0.82rem; padding: 0.5rem 1.25rem;">
            <span>Export / Print Plan</span>
        </button>
    </div>

    <!-- Header & Greeting -->
    <div style="margin-bottom: 1.75rem;">
        <h1 style="font-size: 2rem; margin-bottom: 0.35rem; line-height: 1.2;">
            Nutrition & Training Plan for <span class="brand-accent-text">@Model.FirstName</span>
        </h1>
        <p style="font-size: 0.95rem; color: var(--text-secondary);">
            Goal: <strong>@Model.GoalDisplayName</strong> · Calorie target calculated from your daily metabolic baseline.
        </p>

        @if (!string.IsNullOrEmpty(Model.PaceWarning))
        {
            <div style="background: rgba(245, 158, 11, 0.1); border: 1px solid var(--accent-amber); border-radius: var(--radius-sm); padding: 0.75rem 1.15rem; margin-top: 1rem; font-size: 0.85rem; color: #FCD34D;">
                <strong>Pace Calibration:</strong> @Model.PaceWarning
            </div>
        }

        @if (Model.IsUnder18 || Model.SafetyDisclaimers.Count > 1)
        {
            <div style="background: rgba(239, 68, 68, 0.1); border: 1px solid var(--accent-crimson); border-radius: var(--radius-sm); padding: 0.75rem 1.15rem; margin-top: 0.65rem; font-size: 0.8rem; color: #FCA5A5;">
                @foreach (var disclaimer in Model.SafetyDisclaimers)
                {
                    <div>• @disclaimer</div>
                }
            </div>
        }
    </div>

    <!-- =================================================================
         DYNAMIC SECTION NAVIGATION (No Endless Scrolling!)
         ================================================================= -->
    <div class="result-section-tabs no-print" id="sectionTabs">
        <button type="button" class="section-nav-btn active" onclick="ResultView.showSection('overview', this)">
            📊 Overview & Targets
        </button>
        <button type="button" class="section-nav-btn" onclick="ResultView.showSection('meals', this)">
            🥗 7-Day Meal Schedule
        </button>
        <button type="button" class="section-nav-btn" onclick="ResultView.showSection('grocery', this)">
            🛒 Grocery & Budget (Weekly/Monthly)
        </button>
        <button type="button" class="section-nav-btn" onclick="ResultView.showSection('workout', this)">
            🏋️ Training Routine
        </button>
    </div>

    <!-- =================================================================
         SECTION 1: OVERVIEW & GOAL IMPACT METRICS
         ================================================================= -->
    <div class="result-section-view" id="secOverview">
        
        <!-- Goal Impact Caloric Comparison Box -->
        <div class="goal-comparison-box">
            <div>
                <div style="font-size: 0.78rem; text-transform: uppercase; color: var(--text-muted); font-weight: 700; letter-spacing: 0.05em;">
                    Goal Impact Breakdown
                </div>
                <div style="font-size: 1.1rem; font-weight: 700; color: var(--text-primary); margin: 0.2rem 0;">
                    @Model.GoalAdjustmentDescription
                </div>
                <div style="font-size: 0.85rem; color: var(--text-secondary);">
                    Maintenance Energy (TDEE): <strong>@Model.Tdee.ToString("N0") kcal/day</strong> ➔ Target Goal: <strong class="brand-accent-text">@Model.TargetCalories.ToString("N0") kcal/day</strong>
                </div>
            </div>
            <div style="text-align: right;">
                <span class="budget-verdict-pill @(Model.CalorieAdjustment < 0 ? "budget-verdict-fits" : (Model.CalorieAdjustment > 0 ? "budget-verdict-tight" : "budget-verdict-fits"))">
                    @(Model.CalorieAdjustment > 0 ? $"+{Model.CalorieAdjustment:N0} kcal" : $"{Model.CalorieAdjustment:N0} kcal")
                </span>
            </div>
        </div>

        <!-- Hero Stats Banner (Count-Up Numbers) -->
        <div class="hero-stats-banner">
            <div class="hero-stat-card">
                <div class="hero-stat-val count-up" data-target="@Model.TargetCalories">0</div>
                <div class="hero-stat-label">Daily Goal Target</div>
                <div class="hero-stat-sub">Maintenance: @Model.Tdee.ToString("N0") kcal</div>
            </div>

            <div class="hero-stat-card">
                <div class="hero-stat-val count-up" data-target="@Model.ProteinGrams" style="color: var(--accent-primary);">0</div>
                <div class="hero-stat-label">Protein (High Protection)</div>
                <div class="hero-stat-sub">@Model.ProteinPerKg g/kg · @Model.ProteinCalories kcal</div>
            </div>

            <div class="hero-stat-card">
                <div class="hero-stat-val count-up" data-target="@Model.CarbGrams" style="color: var(--accent-secondary);">0</div>
                <div class="hero-stat-label">Carbohydrates</div>
                <div class="hero-stat-sub">@Model.CarbCalories kcal (Energy fuel)</div>
            </div>

            <div class="hero-stat-card">
                <div class="hero-stat-val count-up" data-target="@Model.FatGrams" style="color: var(--accent-amber);">0</div>
                <div class="hero-stat-label">Essential Fats</div>
                <div class="hero-stat-sub">@Model.FatPercentage% total kcal · @Model.FatCalories kcal</div>
            </div>

            <div class="hero-stat-card">
                <div class="hero-stat-val" style="color: var(--accent-blue);">
                    <span class="count-up" data-target="@Model.WaterIntakeLitres">0</span> L
                </div>
                <div class="hero-stat-label">Daily Water Target</div>
                <div class="hero-stat-sub">~@Model.WaterGlasses glasses (250ml)</div>
            </div>
        </div>

        <!-- Weekly Summary Table -->
        <div style="margin-top: 1.75rem;">
            <h3 style="font-size: 1.15rem; margin-bottom: 0.75rem;">Weekly Nutritional Consistency Matrix</h3>
            <div style="overflow-x: auto;">
                <table style="width: 100%; border-collapse: collapse; font-size: 0.85rem; text-align: left;">
                    <thead>
                        <tr style="border-bottom: 1px solid var(--border-medium); color: var(--text-muted);">
                            <th style="padding: 0.65rem;">Day</th>
                            <th style="padding: 0.65rem;">Focus</th>
                            <th style="padding: 0.65rem;">Calories</th>
                            <th style="padding: 0.65rem;">Protein</th>
                            <th style="padding: 0.65rem;">Carbohydrates</th>
                            <th style="padding: 0.65rem;">Fats</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Model.Days)
                        {
                            <tr style="border-bottom: 1px solid var(--border-subtle);">
                                <td style="padding: 0.6rem; font-weight: 700; color: var(--text-primary);">@d.DayName</td>
                                <td style="padding: 0.6rem; color: var(--text-muted);">@d.DayTheme</td>
                                <td style="padding: 0.6rem; font-weight: 600;">@d.TotalCalories kcal</td>
                                <td style="padding: 0.6rem; color: var(--accent-primary);">@d.TotalProtein g</td>
                                <td style="padding: 0.6rem; color: var(--accent-secondary);">@d.TotalCarbs g</td>
                                <td style="padding: 0.6rem; color: var(--accent-amber);">@d.TotalFat g</td>
                            </tr>
                        }
                        <tr style="background: rgba(16, 185, 129, 0.08); font-weight: bold; border-top: 2px solid var(--accent-primary);">
                            <td style="padding: 0.7rem; color: var(--accent-primary);">Weekly Average</td>
                            <td style="padding: 0.7rem; color: var(--text-secondary);">Target: @Model.TargetCalories kcal</td>
                            <td style="padding: 0.7rem; color: var(--text-primary);">@Model.WeeklyAvgCalories kcal</td>
                            <td style="padding: 0.7rem; color: var(--accent-primary);">@Model.WeeklyAvgProtein g</td>
                            <td style="padding: 0.7rem; color: var(--accent-secondary);">@Model.WeeklyAvgCarbs g</td>
                            <td style="padding: 0.7rem; color: var(--accent-amber);">@Model.WeeklyAvgFat g</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- =================================================================
         SECTION 2: 7-DAY MEAL SCHEDULE
         ================================================================= -->
    <div class="result-section-view" id="secMeals" style="display: none;">
        
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem;">
            <div>
                <h2 style="font-size: 1.4rem;">7-Day Meal Schedule</h2>
                <div style="font-size: 0.85rem; color: var(--text-muted);">Select a day to view its balanced breakfast, lunch, and dinner meal portions.</div>
            </div>
        </div>

        <!-- Day Selector Tabs -->
        <div class="day-tabs-wrapper no-print" id="dayTabs">
            @for (int i = 0; i < Model.Days.Count; i++)
            {
                var day = Model.Days[i];
                <button type="button" class="day-tab-btn @(i == 0 ? "active" : "")" onclick="ResultView.selectDay(@i, this)">
                    @day.DayName
                </button>
            }
        </div>

        <!-- Day Plans -->
        <div id="dayPlansContainer">
            @for (int d = 0; d < Model.Days.Count; d++)
            {
                var day = Model.Days[d];
                <div class="day-plan-card @(d == 0 ? "active" : "")" id="dayPlan_@d" style="@(d == 0 ? "" : "display: none;")">
                    
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; flex-wrap: wrap; gap: 0.5rem;">
                        <div>
                            <h3 style="font-size: 1.2rem; color: var(--accent-primary);">@day.DayName — @day.DayTheme</h3>
                        </div>
                        <div style="background: rgba(255, 255, 255, 0.04); border: 1px solid var(--border-subtle); padding: 0.35rem 0.85rem; border-radius: var(--radius-pill); font-size: 0.82rem; font-weight: 600;">
                            Day Total: <span id="dayTotalKcal_@d">@day.TotalCalories</span> kcal · <span id="dayTotalP_@d" style="color: var(--accent-primary);">@day.TotalProtein g P</span>
                        </div>
                    </div>

                    <!-- Meals in Day -->
                    @foreach (var meal in day.Meals)
                    {
                        <div class="meal-card" id="mealCard_@(d)_@(meal.SlotName)">
                            <div class="meal-header">
                                <div>
                                    <div class="meal-title">@meal.SlotName: @meal.Title</div>
                                    <div style="font-size: 0.75rem; color: var(--text-muted);">@meal.TimingGuidance</div>
                                </div>
                                <div class="meal-macros-badge" id="mealMacrosBadge_@(d)_@(meal.SlotName)">
                                    <strong style="color: var(--text-primary);">@meal.ActualCalories kcal</strong> · 
                                    <span style="color: var(--accent-primary);">@meal.ActualProtein g P</span> · 
                                    <span style="color: var(--accent-secondary);">@meal.ActualCarbs g C</span> · 
                                    <span style="color: var(--accent-amber);">@meal.ActualFat g F</span>
                                </div>
                            </div>

                            <!-- Food Items List -->
                            <ul class="food-items-list" id="mealItems_@(d)_@(meal.SlotName)">
                                @foreach (var item in meal.Items)
                                {
                                    <li class="food-item-row" id="itemRow_@(d)_@(meal.SlotName)_@(item.FoodId)">
                                        <div class="food-name-qty">
                                            <span style="color: var(--accent-primary);">•</span> @item.FoodName
                                            <span style="color: var(--text-muted); font-size: 0.82rem; margin-left: 0.35rem;">(@item.DisplayQuantity)</span>
                                        </div>
                                        <div class="food-macros-chips">
                                            <span>@item.Calories kcal</span>
                                            <span style="color: var(--accent-primary);">@item.Protein g P</span>
                                            <span style="color: var(--accent-secondary);">@item.Carbs g C</span>
                                            <button type="button" class="food-swap-btn no-print" onclick="ResultView.openSwapModal('@item.FoodId', '@item.FoodName', '@item.Category', @item.Calories, @item.Protein, '@meal.SlotName', @d)">
                                                ⇄ Swap
                                            </button>
                                        </div>
                                    </li>
                                }
                            </ul>

                            @if (!string.IsNullOrEmpty(meal.CookingTip))
                            {
                                <div class="cooking-tip-box">
                                    <strong>Prep Tip:</strong> @meal.CookingTip
                                </div>
                            }
                        </div>
                    }

                </div>
            }
        </div>
    </div>

    <!-- =================================================================
         SECTION 3: GROCERY & BUDGET BREAKDOWN (Weekly + Monthly)
         ================================================================= -->
    <div class="result-section-view" id="secGrocery" style="display: none;">
        
        <div style="margin-bottom: 1.5rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.25rem;">
                <div>
                    <h2 style="font-size: 1.4rem;">Weekly & Monthly Grocery Budget</h2>
                    <div style="font-size: 0.85rem; color: var(--text-muted);">Regional price index grounded to local market staples.</div>
                </div>
                <div class="budget-verdict-pill budget-verdict-@Model.GroceryBudget.Verdict">
                    <span>@Model.GroceryBudget.VerdictTitle</span>
                </div>
            </div>

            <!-- Notes -->
            <p style="font-size: 0.92rem; color: var(--text-secondary); margin-bottom: 1.25rem;">
                @Model.GroceryBudget.Notes
            </p>

            <!-- Cost Summary Strip -->
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 1.5rem;">
                <div style="background: var(--bg-card); border: 1px solid var(--border-subtle); padding: 1.15rem; border-radius: var(--radius-sm); text-align: center;">
                    <div style="font-size: 0.72rem; text-transform: uppercase; color: var(--text-muted); font-weight: 700;">Est. Weekly Grocery Cost</div>
                    <div style="font-family: var(--font-heading); font-size: 1.7rem; font-weight: 800; color: var(--accent-primary); margin-top: 0.2rem;">
                        @Model.GroceryBudget.Currency @Model.GroceryBudget.EstimatedWeeklyCost.ToString("N0")
                    </div>
                </div>

                <div style="background: var(--bg-card); border: 1px solid var(--border-subtle); padding: 1.15rem; border-radius: var(--radius-sm); text-align: center;">
                    <div style="font-size: 0.72rem; text-transform: uppercase; color: var(--text-muted); font-weight: 700;">Est. Monthly Total Cost</div>
                    <div style="font-family: var(--font-heading); font-size: 1.7rem; font-weight: 800; color: var(--text-primary); margin-top: 0.2rem;">
                        @Model.GroceryBudget.Currency @Model.GroceryBudget.EstimatedMonthlyCost.ToString("N0")
                    </div>
                </div>

                @if (Model.GroceryBudget.UserMonthlyBudget.HasValue && Model.GroceryBudget.UserMonthlyBudget > 0)
                {
                    <div style="background: var(--bg-card); border: 1px solid var(--border-subtle); padding: 1.15rem; border-radius: var(--radius-sm); text-align: center;">
                        <div style="font-size: 0.72rem; text-transform: uppercase; color: var(--text-muted); font-weight: 700;">Declared Target Budget</div>
                        <div style="font-family: var(--font-heading); font-size: 1.7rem; font-weight: 800; color: var(--accent-secondary); margin-top: 0.2rem;">
                            @Model.GroceryBudget.Currency @Model.GroceryBudget.UserMonthlyBudget.Value.ToString("N0")
                        </div>
                    </div>
                }
            </div>

            <!-- Cost-Saving Recommendations -->
            @if (Model.GroceryBudget.SwapSuggestions.Count > 0)
            {
                <div style="background: rgba(16, 185, 129, 0.05); border: 1px solid var(--accent-border); border-radius: var(--radius-sm); padding: 1.15rem; margin-bottom: 1.5rem;">
                    <div style="font-weight: 700; font-size: 0.9rem; color: var(--accent-primary); margin-bottom: 0.4rem;">
                        💡 Budget Optimization Tips:
                    </div>
                    <ul style="padding-left: 1.2rem; font-size: 0.85rem; color: var(--text-secondary);">
                        @foreach (var tip in Model.GroceryBudget.SwapSuggestions)
                        {
                            <li style="margin-bottom: 0.25rem;">@tip</li>
                        }
                    </ul>
                </div>
            }

            <!-- 7-Day Shopping Cart Checklist -->
            <div style="background: var(--bg-surface-elevated); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: 1.5rem;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; flex-wrap: wrap; gap: 0.5rem;">
                    <div>
                        <h3 style="font-size: 1.15rem;">7-Day Shopping Cart Breakdown</h3>
                        <div style="font-size: 0.78rem; color: var(--text-muted);">Weekly food requirements and estimated cost by category.</div>
                    </div>
                    <button type="button" class="btn-secondary no-print" onclick="ResultView.copyGroceryList()" style="font-size: 0.78rem; padding: 0.4rem 0.85rem;">
                        📋 Copy List
                    </button>
                </div>

                @{
                    var grouped = Model.GroceryBudget.Items.GroupBy(i => i.Category).ToList();
                }

                @foreach (var group in grouped)
                {
                    <div class="grocery-category-block">
                        <div class="grocery-category-title">
                            @group.Key
                        </div>
                        @foreach (var item in group)
                        {
                            <div class="checklist-item" id="chkItem_@(item.FoodId)">
                                <label class="checklist-label">
                                    <input type="checkbox" class="checklist-checkbox" onchange="ResultView.toggleChecklistItem(this)" />
                                    <span>
                                        <strong>@item.FoodName</strong>: 
                                        <span style="color: var(--accent-primary);">@item.DisplayWeeklyQuantity</span>
                                    </span>
                                </label>
                                <span style="font-size: 0.8rem; color: var(--text-muted);">
                                    Weekly: ~@item.Currency @item.TotalCost.ToString("N0") | Mo: ~@item.Currency @item.EstimatedMonthlyCost.ToString("N0")
                                </span>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- =================================================================
         SECTION 4: TRAINING & WORKOUT SCHEDULE
         ================================================================= -->
    <div class="result-section-view" id="secWorkout" style="display: none;">
        
        <div style="margin-bottom: 1.5rem;">
            <div style="margin-bottom: 1.25rem;">
                <h2 style="font-size: 1.4rem; margin-bottom: 0.35rem;">@Model.ExercisePlan.ProgramTitle</h2>
                <p style="font-size: 0.92rem; color: var(--text-secondary);">
                    @Model.ExercisePlan.Rationale
                </p>
                @if (!string.IsNullOrEmpty(Model.ExercisePlan.WalkingRationale))
                {
                    <div style="font-size: 0.85rem; color: var(--accent-primary); margin-top: 0.45rem;">
                        🚶 @Model.ExercisePlan.WalkingRationale
                    </div>
                }
            </div>

            <!-- Training Schedule Days -->
            @foreach (var workoutDay in Model.ExercisePlan.Schedule)
            {
                <div style="background: var(--bg-card); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: 1.35rem; margin-bottom: 1.25rem;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem; border-bottom: 1px solid var(--border-subtle); padding-bottom: 0.5rem;">
                        <div>
                            <h3 style="font-size: 1.05rem; color: var(--text-primary);">@workoutDay.DayTitle</h3>
                            <div style="font-size: 0.78rem; color: var(--text-muted);">Focus: @workoutDay.Focus · ~@workoutDay.EstimatedMinutes min</div>
                        </div>
                        @if (workoutDay.IsRestDay)
                        {
                            <span style="background: rgba(16, 185, 129, 0.12); color: var(--accent-primary); border: 1px solid var(--accent-primary); padding: 0.2rem 0.65rem; border-radius: var(--radius-pill); font-size: 0.75rem; font-weight: 700;">
                                RECOVERY
                            </span>
                        }
                    </div>

                    <div style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 0.75rem;">
                        <strong>Warm-Up:</strong> @workoutDay.Warmup
                    </div>

                    <!-- Exercises -->
                    @foreach (var ex in workoutDay.Exercises)
                    {
                        <div class="workout-exercise-card">
                            <div class="workout-exercise-title">
                                <span>@ex.Name</span>
                                <span class="workout-exercise-target">@ex.TargetMuscle</span>
                            </div>
                            <div class="workout-stats-strip">
                                <span><strong>Sets:</strong> @ex.Sets</span>
                                <span><strong>Reps:</strong> @ex.Reps</span>
                                @if (ex.RestSeconds > 0)
                                {
                                    <span><strong>Rest:</strong> @ex.RestSeconds sec</span>
                                }
                            </div>
                            <div class="workout-form-cue">
                                "@ex.FormCue"
                            </div>
                            @if (!string.IsNullOrEmpty(ex.Regression))
                            {
                                <div style="font-size: 0.75rem; color: var(--accent-amber); margin-top: 0.25rem;">
                                    ↳ <em>Beginner Regression:</em> @ex.Regression
                                </div>
                            }
                        </div>
                    }

                    <div style="font-size: 0.8rem; color: var(--text-muted); margin-top: 0.65rem;">
                        <strong>Cool-Down:</strong> @workoutDay.Cooldown
                    </div>
                </div>
            }
        </div>
    </div>

</div>

<!-- =================================================================
     INTERACTIVE FOOD SWAP MODAL
     ================================================================= -->
<div class="swap-modal-backdrop" id="swapModal">
    <div class="swap-modal-box">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; border-bottom: 1px solid var(--border-subtle); padding-bottom: 0.5rem;">
            <h3 style="font-size: 1.1rem;">Swap Food Item</h3>
            <button type="button" onclick="ResultView.closeSwapModal()" style="background: transparent; border: none; color: var(--text-muted); font-size: 1.4rem; cursor: pointer;">&times;</button>
        </div>

        <div style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 1rem;" id="swapOriginalText">
            Replacing food item...
        </div>

        <div class="form-group">
            <label class="form-label" for="swapFoodSelect">Select Replacement</label>
            <select id="swapFoodSelect" class="form-select"></select>
        </div>

        <div style="display: flex; justify-content: flex-end; gap: 0.6rem; margin-top: 1.25rem;">
            <button type="button" class="btn-secondary" onclick="ResultView.closeSwapModal()">Cancel</button>
            <button type="button" class="btn-primary" onclick="ResultView.executeFoodSwap()">Calibrate & Swap</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/result.js" asp-append-version="true"></script>
}
