@model ValensFit.Models.PlanResultModel
@{
    ViewData["Title"] = $"{Model.FirstName}'s Imperial Nutrition & Training Scroll";
}

<!-- Master Results Container -->
<div class="roman-card" id="resultsContainer" style="margin-bottom: 2rem;">

    <!-- Top Action Bar -->
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.5rem;" class="no-print">
        <a href="/Plan" class="btn-roman-secondary btn-roman" style="font-size: 0.82rem; padding: 0.5rem 1.2rem;">
            <span>↺ Start Over</span>
        </a>
        <div style="display: flex; gap: 0.75rem;">
            <button type="button" class="btn-roman" onclick="window.print()" style="font-size: 0.85rem; padding: 0.6rem 1.4rem;">
                <span>📜 Export / Print Scroll</span>
            </button>
        </div>
    </div>

    <!-- Header & Greeting -->
    <div style="text-align: center; margin-bottom: 2rem;">
        <div class="column-divider">
            <div class="line"></div>
            <div class="laurel-icon">❖ VALENSFIT IMPERIAL DECREE ❖</div>
            <div class="line"></div>
        </div>

        <h1 style="font-size: 2.4rem; margin-bottom: 0.5rem; line-height: 1.2;">
            WELCOME, <span class="gold-text">@Model.FirstName.ToUpper()</span>
        </h1>
        <p style="font-size: 1.05rem; color: var(--text-secondary); max-width: 650px; margin: 0 auto;">
            Here is your deterministic 7-day nutritional blueprint and @Model.ExercisePlan.Preference training regiment.
        </p>

        <!-- Safety / Pace Banner -->
        @if (!string.IsNullOrEmpty(Model.PaceWarning))
        {
            <div style="background: rgba(212, 175, 55, 0.1); border: 1px solid var(--gold-border); border-radius: var(--radius-sm); padding: 0.85rem 1.25rem; margin: 1.25rem auto 0; max-width: 750px; text-align: left; font-size: 0.88rem; color: var(--gold-light);">
                <strong>⚡ Metabolic Pace Calibration:</strong> @Model.PaceWarning
            </div>
        }

        @if (Model.IsUnder18 || Model.SafetyDisclaimers.Count > 1)
        {
            <div style="background: rgba(122, 31, 43, 0.15); border: 1px solid var(--imperial-red); border-radius: var(--radius-sm); padding: 0.85rem 1.25rem; margin: 0.75rem auto 0; max-width: 750px; text-align: left; font-size: 0.82rem; color: #FEB2B2;">
                @foreach (var disclaimer in Model.SafetyDisclaimers)
                {
                    <div>• @disclaimer</div>
                }
            </div>
        }
    </div>

    <!-- =================================================================
         HERO METRICS BANNER (Count-Up Numbers)
         ================================================================= -->
    <div class="hero-stats-banner">
        <div class="hero-stat-card">
            <div class="hero-stat-val count-up" data-target="@Model.TargetCalories">0</div>
            <div class="hero-stat-label">Daily Calories</div>
            <div class="hero-stat-sub">BMR: @Model.Bmr.ToString("N0") · TDEE: @Model.Tdee.ToString("N0")</div>
        </div>

        <div class="hero-stat-card">
            <div class="hero-stat-val count-up" data-target="@Model.ProteinGrams" style="color: #68D391;">0</div>
            <div class="hero-stat-label">Protein Target</div>
            <div class="hero-stat-sub">@Model.ProteinPerKg g/kg · @Model.ProteinCalories kcal</div>
        </div>

        <div class="hero-stat-card">
            <div class="hero-stat-val count-up" data-target="@Model.CarbGrams" style="color: #63B3ED;">0</div>
            <div class="hero-stat-label">Carbohydrates</div>
            <div class="hero-stat-sub">@Model.CarbCalories kcal (Glycogen fuel)</div>
        </div>

        <div class="hero-stat-card">
            <div class="hero-stat-val count-up" data-target="@Model.FatGrams" style="color: #F6AD55;">0</div>
            <div class="hero-stat-label">Essential Fats</div>
            <div class="hero-stat-sub">@Model.FatPercentage% total kcal · @Model.FatCalories kcal</div>
        </div>

        <div class="hero-stat-card">
            <div class="hero-stat-val" style="color: #4FD1C5;">
                <span class="count-up" data-target="@Model.WaterIntakeLitres">0</span> L
            </div>
            <div class="hero-stat-label">Daily Hydration</div>
            <div class="hero-stat-sub">~@Model.WaterGlasses glasses (250ml)</div>
        </div>
    </div>

    <!-- Column Divider -->
    <div class="column-divider">
        <div class="line"></div>
        <div class="laurel-icon">❖ SECTION I · 7-DAY NUTRITION SCHEDULE ❖</div>
        <div class="line"></div>
    </div>

    <!-- Day Selector Tabs -->
    <div class="day-tabs-wrapper no-print" id="dayTabs">
        @for (int i = 0; i < Model.Days.Count; i++)
        {
            var day = Model.Days[i];
            <button type="button" class="day-tab-btn @(i == 0 ? "active" : "")" onclick="ResultView.selectDay(@i, this)">
                @day.DayName
            </button>
        }
    </div>

    <!-- 7 Day Meal Plans (Only active day is visible on screen, all print on media print) -->
    <div id="dayPlansContainer">
        @for (int d = 0; d < Model.Days.Count; d++)
        {
            var day = Model.Days[d];
            <div class="day-plan-card @(d == 0 ? "active" : "")" id="dayPlan_@d" style="@(d == 0 ? "" : "display: none;")">
                
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; flex-wrap: wrap; gap: 0.5rem;">
                    <div>
                        <h3 style="font-size: 1.35rem; color: var(--gold-light);">@day.DayName</h3>
                        <div style="font-size: 0.85rem; color: var(--text-muted);">@day.DayTheme</div>
                    </div>
                    <div style="background: rgba(212, 175, 55, 0.1); border: 1px solid var(--border-gold); padding: 0.4rem 1rem; border-radius: var(--radius-pill); font-size: 0.85rem; color: var(--gold-light); font-weight: 700;">
                        Daily Totals: @day.TotalCalories kcal · @day.TotalProtein g P · @day.TotalCarbs g C · @day.TotalFat g F
                    </div>
                </div>

                <!-- Meals in Day -->
                @foreach (var meal in day.Meals)
                {
                    <div class="meal-card">
                        <div class="meal-header">
                            <div>
                                <div class="meal-title">@meal.SlotName — @meal.Title</div>
                                <div style="font-size: 0.78rem; color: var(--text-muted);">@meal.TimingGuidance</div>
                            </div>
                            <div class="meal-macros-badge">
                                <strong style="color: var(--text-primary);">@meal.ActualCalories kcal</strong> · 
                                <span style="color: #68D391;">@meal.ActualProtein g P</span> · 
                                <span style="color: #63B3ED;">@meal.ActualCarbs g C</span> · 
                                <span style="color: #F6AD55;">@meal.ActualFat g F</span>
                            </div>
                        </div>

                        <!-- Food Items List -->
                        <ul class="food-items-list" id="mealItems_@(d)_@(meal.SlotName)">
                            @foreach (var item in meal.Items)
                            {
                                <li class="food-item-row" id="itemRow_@(item.FoodId)">
                                    <div class="food-name-qty">
                                        <span style="color: var(--gold-light);">✦</span> @item.FoodName
                                        <span style="color: var(--text-muted); font-size: 0.85rem; margin-left: 0.4rem;">(@item.DisplayQuantity)</span>
                                    </div>
                                    <div class="food-macros-chips">
                                        <span>@item.Calories kcal</span>
                                        <span style="color: #68D391;">@item.Protein g P</span>
                                        <span style="color: #63B3ED;">@item.Carbs g C</span>
                                        <span style="color: #F6AD55;">@item.Fat g F</span>
                                        <button type="button" class="food-swap-btn no-print" onclick="ResultView.openSwapModal('@item.FoodId', '@item.FoodName', '@item.Category', @item.Calories, @item.Protein, '@meal.SlotName', @d)">
                                            ⇄ Swap
                                        </button>
                                    </div>
                                </li>
                            }
                        </ul>

                        @if (!string.IsNullOrEmpty(meal.CookingTip))
                        {
                            <div class="cooking-tip-box">
                                <strong>👨‍🍳 Preparation Tip:</strong> @meal.CookingTip
                            </div>
                        }
                    </div>
                }

            </div>
        }
    </div>

    <!-- =================================================================
         WEEKLY NUTRITION MATRIX TABLE
         ================================================================= -->
    <div class="column-divider" style="margin-top: 3rem;">
        <div class="line"></div>
        <div class="laurel-icon">❖ WEEKLY NUTRITIONAL ACCURACY MATRIX ❖</div>
        <div class="line"></div>
    </div>

    <div style="overflow-x: auto; margin: 1.5rem 0;">
        <table style="width: 100%; border-collapse: collapse; font-size: 0.88rem; text-align: left;">
            <thead>
                <tr style="border-bottom: 1px solid var(--border-gold); color: var(--gold-antique); font-family: var(--font-roman);">
                    <th style="padding: 0.75rem;">Day</th>
                    <th style="padding: 0.75rem;">Theme</th>
                    <th style="padding: 0.75rem;">Calories</th>
                    <th style="padding: 0.75rem;">Protein</th>
                    <th style="padding: 0.75rem;">Carbohydrates</th>
                    <th style="padding: 0.75rem;">Fats</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model.Days)
                {
                    <tr style="border-bottom: 1px solid var(--border-subtle);">
                        <td style="padding: 0.65rem; font-weight: 700; color: var(--gold-light);">@d.DayName</td>
                        <td style="padding: 0.65rem; color: var(--text-muted);">@d.DayTheme</td>
                        <td style="padding: 0.65rem; font-weight: 600;">@d.TotalCalories kcal</td>
                        <td style="padding: 0.65rem; color: #68D391;">@d.TotalProtein g</td>
                        <td style="padding: 0.65rem; color: #63B3ED;">@d.TotalCarbs g</td>
                        <td style="padding: 0.65rem; color: #F6AD55;">@d.TotalFat g</td>
                    </tr>
                }
                <tr style="background: rgba(212, 175, 55, 0.08); font-weight: bold; border-top: 2px solid var(--border-gold);">
                    <td style="padding: 0.75rem; color: var(--gold-primary);">Weekly Average</td>
                    <td style="padding: 0.75rem; color: var(--text-secondary);">Target: @Model.TargetCalories kcal</td>
                    <td style="padding: 0.75rem; color: var(--text-primary);">@Model.WeeklyAvgCalories kcal</td>
                    <td style="padding: 0.75rem; color: #68D391;">@Model.WeeklyAvgProtein g</td>
                    <td style="padding: 0.75rem; color: #63B3ED;">@Model.WeeklyAvgCarbs g</td>
                    <td style="padding: 0.75rem; color: #F6AD55;">@Model.WeeklyAvgFat g</td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- =================================================================
         GROCERY SHOPPING LIST & BUDGET VERDICT
         ================================================================= -->
    <div class="column-divider" style="margin-top: 3.5rem;">
        <div class="line"></div>
        <div class="laurel-icon">❖ SECTION II · GROCERY & LOCAL BUDGET VERDICT ❖</div>
        <div class="line"></div>
    </div>

    <div style="margin: 1.5rem 0;">
        <!-- Budget Verdict Stamped Wax Seal -->
        <div style="text-align: center; margin-bottom: 1.5rem;">
            <div class="wax-seal-badge wax-seal-@Model.GroceryBudget.Verdict">
                <span>❖</span>
                <span>@Model.GroceryBudget.VerdictTitle</span>
                <span>❖</span>
            </div>
            <div style="font-size: 0.95rem; color: var(--text-secondary); max-width: 650px; margin: 0.5rem auto;">
                @Model.GroceryBudget.Notes
            </div>
            <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 0.35rem;">
                Pricing Source: <span style="color: var(--gold-antique);">@Model.GroceryBudget.Source</span>
            </div>
        </div>

        <!-- Budget Stats Strip -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 2rem;">
            <div style="background: var(--bg-card); border: 1px solid var(--border-subtle); padding: 1.25rem; border-radius: var(--radius-sm); text-align: center;">
                <div style="font-size: 0.75rem; text-transform: uppercase; color: var(--gold-antique); font-weight: 700;">Est. Weekly Grocery Cost</div>
                <div style="font-family: var(--font-roman); font-size: 1.8rem; font-weight: 800; color: var(--gold-light); margin-top: 0.25rem;">
                    @Model.GroceryBudget.Currency @Model.GroceryBudget.EstimatedWeeklyCost.ToString("N0")
                </div>
            </div>

            <div style="background: var(--bg-card); border: 1px solid var(--border-subtle); padding: 1.25rem; border-radius: var(--radius-sm); text-align: center;">
                <div style="font-size: 0.75rem; text-transform: uppercase; color: var(--gold-antique); font-weight: 700;">Est. Monthly Expenditure</div>
                <div style="font-family: var(--font-roman); font-size: 1.8rem; font-weight: 800; color: var(--text-primary); margin-top: 0.25rem;">
                    @Model.GroceryBudget.Currency @Model.GroceryBudget.EstimatedMonthlyCost.ToString("N0")
                </div>
            </div>

            @if (Model.GroceryBudget.UserMonthlyBudget.HasValue && Model.GroceryBudget.UserMonthlyBudget > 0)
            {
                <div style="background: var(--bg-card); border: 1px solid var(--border-subtle); padding: 1.25rem; border-radius: var(--radius-sm); text-align: center;">
                    <div style="font-size: 0.75rem; text-transform: uppercase; color: var(--gold-antique); font-weight: 700;">Declared Budget Allocation</div>
                    <div style="font-family: var(--font-roman); font-size: 1.8rem; font-weight: 800; color: var(--gold-primary); margin-top: 0.25rem;">
                        @Model.GroceryBudget.Currency @Model.GroceryBudget.UserMonthlyBudget.Value.ToString("N0")
                    </div>
                </div>
            }
        </div>

        <!-- Swap Suggestions & Optimization Notes -->
        @if (Model.GroceryBudget.SwapSuggestions.Count > 0)
        {
            <div style="background: rgba(212, 175, 55, 0.06); border: 1px solid var(--border-gold); border-radius: var(--radius-sm); padding: 1.25rem; margin-bottom: 2rem;">
                <div style="font-family: var(--font-roman); font-weight: 700; font-size: 0.95rem; color: var(--gold-light); margin-bottom: 0.5rem;">
                    💡 Budget Optimization & Cost-Saving Swaps:
                </div>
                <ul style="padding-left: 1.25rem; font-size: 0.88rem; color: var(--text-secondary);">
                    @foreach (var swap in Model.GroceryBudget.SwapSuggestions)
                    {
                        <li style="margin-bottom: 0.35rem;">@swap</li>
                    }
                </ul>
            </div>
        }

        <!-- Interactive Grocery Shopping Checklist -->
        <div style="background: var(--bg-surface-elevated); border: 1px solid var(--border-gold); border-radius: var(--radius-md); padding: 1.75rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; flex-wrap: wrap; gap: 0.5rem;">
                <div>
                    <h3 style="font-size: 1.25rem; color: var(--gold-light);">7-Day Shopping Cart Checklist</h3>
                    <div style="font-size: 0.8rem; color: var(--text-muted);">Exact aggregated weekly quantities needed for your meal schedule.</div>
                </div>
                <button type="button" class="btn-roman-secondary btn-roman no-print" onclick="ResultView.copyGroceryList()" style="font-size: 0.8rem; padding: 0.45rem 1rem;">
                    📋 Copy Checklist
                </button>
            </div>

            <!-- Group items by category -->
            @{
                var grouped = Model.GroceryBudget.Items.GroupBy(i => i.Category).ToList();
            }

            @foreach (var group in grouped)
            {
                <div class="grocery-category-block">
                    <div class="grocery-category-title">
                        <span>❖</span> @group.Key.ToUpper()
                    </div>
                    @foreach (var item in group)
                    {
                        <div class="checklist-item" id="chkItem_@(item.FoodId)">
                            <label class="checklist-label">
                                <input type="checkbox" class="checklist-checkbox" onchange="ResultView.toggleChecklistItem(this)" />
                                <span>
                                    <strong>@item.FoodName</strong>: 
                                    <span style="color: var(--gold-light);">@item.DisplayWeeklyQuantity</span>
                                </span>
                            </label>
                            <span style="font-size: 0.82rem; color: var(--text-muted);">
                                ~@item.Currency @item.TotalCost.ToString("N0")
                            </span>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- =================================================================
         EXERCISE & TRAINING REGIMENT
         ================================================================= -->
    <div class="column-divider" style="margin-top: 3.5rem;">
        <div class="line"></div>
        <div class="laurel-icon">❖ SECTION III · TRAINING REGIMENT ❖</div>
        <div class="line"></div>
    </div>

    <div style="margin: 1.5rem 0;">
        <div style="text-align: center; margin-bottom: 1.75rem;">
            <h2 style="font-size: 1.8rem; margin-bottom: 0.5rem;">@Model.ExercisePlan.ProgramTitle</h2>
            <p style="font-size: 0.95rem; color: var(--text-secondary); max-width: 680px; margin: 0 auto;">
                @Model.ExercisePlan.Rationale
            </p>
            @if (!string.IsNullOrEmpty(Model.ExercisePlan.WalkingRationale))
            {
                <div style="font-size: 0.85rem; color: var(--gold-antique); margin-top: 0.5rem;">
                    🚶 @Model.ExercisePlan.WalkingRationale
                </div>
            }
        </div>

        <!-- Training Schedule -->
        @foreach (var workoutDay in Model.ExercisePlan.Schedule)
        {
            <div style="background: var(--bg-card); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: 1.5rem; margin-bottom: 1.5rem;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; border-bottom: 1px solid var(--border-subtle); padding-bottom: 0.65rem;">
                    <div>
                        <h3 style="font-size: 1.15rem; color: var(--gold-light);">@workoutDay.DayTitle</h3>
                        <div style="font-size: 0.8rem; color: var(--text-muted);">Focus: @workoutDay.Focus · ~@workoutDay.EstimatedMinutes min</div>
                    </div>
                    @if (workoutDay.IsRestDay)
                    {
                        <span style="background: rgba(104, 211, 145, 0.15); color: #68D391; border: 1px solid #68D391; padding: 0.25rem 0.75rem; border-radius: var(--radius-pill); font-size: 0.78rem; font-weight: 700;">
                            ACTIVE RECOVERY
                        </span>
                    }
                </div>

                <div style="font-size: 0.82rem; color: var(--text-muted); margin-bottom: 1rem;">
                    <strong>🔥 Warm-Up:</strong> @workoutDay.Warmup
                </div>

                <!-- Exercises -->
                @foreach (var ex in workoutDay.Exercises)
                {
                    <div class="workout-exercise-card">
                        <div class="workout-exercise-title">
                            <span>@ex.Name</span>
                            <span class="workout-exercise-target">@ex.TargetMuscle</span>
                        </div>
                        <div class="workout-stats-strip">
                            <span><strong>Sets:</strong> @ex.Sets</span>
                            <span><strong>Reps:</strong> @ex.Reps</span>
                            @if (ex.RestSeconds > 0)
                            {
                                <span><strong>Rest:</strong> @ex.RestSeconds sec</span>
                            }
                        </div>
                        <div class="workout-form-cue">
                            " @ex.FormCue "
                        </div>
                        @if (!string.IsNullOrEmpty(ex.Regression))
                        {
                            <div style="font-size: 0.75rem; color: #ECC94B; margin-top: 0.35rem;">
                                ↳ <em>Beginner Regression:</em> @ex.Regression
                            </div>
                        }
                    </div>
                }

                <div style="font-size: 0.82rem; color: var(--text-muted); margin-top: 0.75rem;">
                    <strong>❄️ Cool-Down:</strong> @workoutDay.Cooldown
                </div>
            </div>
        }
    </div>

    <!-- Master Bottom Action Bar -->
    <div style="text-align: center; margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--border-subtle);" class="no-print">
        <button type="button" class="btn-roman" onclick="window.print()" style="font-size: 1.05rem; padding: 1rem 2.5rem;">
            <span>📜 Print / Save Imperial Scroll</span>
        </button>
    </div>

</div>

<!-- =================================================================
     INTERACTIVE FOOD SWAP MODAL
     ================================================================= -->
<div class="swap-modal-backdrop" id="swapModal">
    <div class="swap-modal-box">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 1px solid var(--border-gold); padding-bottom: 0.75rem;">
            <h3 style="font-size: 1.2rem; color: var(--gold-light);">Swap Food Item</h3>
            <button type="button" onclick="ResultView.closeSwapModal()" style="background: transparent; border: none; color: var(--text-muted); font-size: 1.5rem; cursor: pointer;">&times;</button>
        </div>

        <div style="font-size: 0.88rem; color: var(--text-secondary); margin-bottom: 1rem;" id="swapOriginalText">
            Replacing: <strong>Chicken Breast (180g)</strong>
        </div>

        <div class="form-group">
            <label class="form-label" for="swapFoodSelect">Select Alternative Food</label>
            <select id="swapFoodSelect" class="form-select"></select>
        </div>

        <div style="display: flex; justify-content: flex-end; gap: 0.75rem; margin-top: 1.5rem;">
            <button type="button" class="btn-roman-secondary btn-roman" onclick="ResultView.closeSwapModal()">Cancel</button>
            <button type="button" class="btn-roman" onclick="ResultView.executeFoodSwap()">Calibrate & Swap</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/result.js" asp-append-version="true"></script>
}
