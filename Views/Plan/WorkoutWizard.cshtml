@model ValensFit.Models.UserInputModel
@{
    ViewData["Title"] = "Workout & Fitness Planner (Dhaka)";
}

<div class="clean-card" id="workoutWizardContainer">
    <!-- Header -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 1px solid var(--border-subtle); padding-bottom: 0.75rem;">
        <div>
            <a href="/" style="font-size: 0.8rem; color: var(--text-muted); text-decoration: none;">← Back to Modes</a>
            <h1 style="font-size: 1.6rem; margin-top: 0.2rem;">🏋️ Workout & Training Planner</h1>
        </div>
        <span class="budget-verdict-pill budget-verdict-fits">MET Calorie Analytics</span>
    </div>

    <!-- Progress Tracker -->
    <div class="wizard-progress-bar no-print" id="workoutProgressBar">
        <div class="progress-track"></div>
        <div class="progress-fill" id="workoutProgressFill" style="width: 0%;"></div>
        
        <div class="step-node active" data-step="1" title="Biometrics">1</div>
        <div class="step-node" data-step="2" title="Training Schedule">2</div>
    </div>

    <form id="workoutPlanForm" onsubmit="return false;">
        
        <!-- STEP 1: IDENTITY & BIOMETRICS (FOR ACCURATE MET CALORIE BURN) -->
        <div class="wizard-step active" id="workoutStep1">
            <h2 style="font-size: 1.25rem; margin-bottom: 0.35rem;">Your Physical Profile</h2>
            <p style="font-size: 0.88rem; color: var(--text-secondary); margin-bottom: 1.25rem;">
                Body mass and biological profile are required to compute accurate energy expenditure (MET equations).
            </p>

            <div class="form-group">
                <label class="form-label" for="workoutFirstName">Your Name *</label>
                <input type="text" id="workoutFirstName" class="form-input" placeholder="e.g. Tanvir, Rafi, Nusrat" required />
                <div class="validation-msg" id="workoutNameValMsg">Please enter your name.</div>
            </div>

            <!-- Sex Selection -->
            <div class="form-group">
                <label class="form-label">Biological Sex *</label>
                <div class="card-selector-grid" style="grid-template-columns: 1fr 1fr;">
                    <div class="select-card selected" data-field="workoutGender" data-value="Male" onclick="WorkoutWizard.selectCard(this, 'workoutGender', 'Male')">
                        <div class="select-card-title">Male</div>
                    </div>
                    <div class="select-card" data-field="workoutGender" data-value="Female" onclick="WorkoutWizard.selectCard(this, 'workoutGender', 'Female')">
                        <div class="select-card-title">Female</div>
                    </div>
                </div>
                <input type="hidden" id="workoutGender" value="Male" />
            </div>

            <!-- Age, Height, Weight -->
            <div class="biometrics-row">
                <div class="form-group">
                    <label class="form-label" for="workoutAge">Age (Years) *</label>
                    <input type="number" id="workoutAge" class="form-input" min="13" max="80" placeholder="e.g. 25" required />
                    <div class="validation-msg" id="workoutAgeValMsg">Age must be between 13 and 80.</div>
                </div>

                <div class="form-group">
                    <div class="input-header-row">
                        <label class="form-label" style="margin-bottom: 0;">Height *</label>
                        <div class="unit-toggle-group">
                            <button type="button" class="unit-toggle-btn active" id="wUnitCmBtn" onclick="WorkoutWizard.setHeightUnit('cm')">cm</button>
                            <button type="button" class="unit-toggle-btn" id="wUnitFtBtn" onclick="WorkoutWizard.setHeightUnit('ft')">ft/in</button>
                        </div>
                    </div>
                    <div id="wHeightCmWrap">
                        <input type="number" id="workoutHeightCm" class="form-input" min="100" max="250" placeholder="e.g. 175" />
                    </div>
                    <div id="wHeightFtWrap" style="display: none; gap: 0.5rem;">
                        <input type="number" id="workoutHeightFt" class="form-input" min="3" max="8" placeholder="Ft (5)" style="width: 50%;" />
                        <input type="number" id="workoutHeightIn" class="form-input" min="0" max="11" placeholder="In (9)" style="width: 50%;" />
                    </div>
                    <div class="validation-msg" id="workoutHeightValMsg">Please enter a valid height.</div>
                    <input type="hidden" id="workoutHeightUnit" value="cm" />
                </div>

                <div class="form-group">
                    <div class="input-header-row">
                        <label class="form-label" style="margin-bottom: 0;">Weight *</label>
                        <div class="unit-toggle-group">
                            <button type="button" class="unit-toggle-btn active" id="wUnitKgBtn" onclick="WorkoutWizard.setWeightUnit('kg')">kg</button>
                            <button type="button" class="unit-toggle-btn" id="wUnitLbBtn" onclick="WorkoutWizard.setWeightUnit('lb')">lbs</button>
                        </div>
                    </div>
                    <input type="number" id="workoutWeight" class="form-input" min="25" max="300" placeholder="e.g. 70" required />
                    <div class="validation-msg" id="workoutWeightValMsg">Please enter a valid weight.</div>
                    <input type="hidden" id="workoutWeightUnit" value="kg" />
                </div>
            </div>

            <div class="wizard-footer">
                <a href="/" class="btn-secondary">Cancel</a>
                <button type="button" class="btn-primary" onclick="WorkoutWizard.nextStep(1)">
                    <span>Next: Training Preferences</span>
                    <span>➔</span>
                </button>
            </div>
        </div>

        <!-- STEP 2: TRAINING PARAMETERS & MODALITY -->
        <div class="wizard-step" id="workoutStep2" style="display: none;">
            <h2 style="font-size: 1.25rem; margin-bottom: 0.35rem;">Training Routine & Schedule</h2>
            <p style="font-size: 0.88rem; color: var(--text-secondary); margin-bottom: 1.25rem;">
                Select your training modality, available frequency, and daily step targets.
            </p>

            <!-- Training Goal -->
            <div class="form-group">
                <label class="form-label">Training Goal</label>
                <div class="card-selector-grid">
                    <div class="select-card selected" data-field="wGoal" data-value="Hypertrophy" onclick="WorkoutWizard.selectCard(this, 'wGoal', 'Hypertrophy')">
                        <div class="select-card-title">💪 Muscle Hypertrophy</div>
                        <div class="select-card-desc">8-12 rep range, progressive tension</div>
                    </div>
                    <div class="select-card" data-field="wGoal" data-value="FatLoss" onclick="WorkoutWizard.selectCard(this, 'wGoal', 'FatLoss')">
                        <div class="select-card-title">🔥 Conditioning & Fat Burn</div>
                        <div class="select-card-desc">Higher density, shorter rest intervals</div>
                    </div>
                    <div class="select-card" data-field="wGoal" data-value="Strength" onclick="WorkoutWizard.selectCard(this, 'wGoal', 'Strength')">
                        <div class="select-card-title">⚡ Raw Strength & Power</div>
                        <div class="select-card-desc">Heavy compound sets, 3-6 rep focus</div>
                    </div>
                </div>
                <input type="hidden" id="wGoal" value="Hypertrophy" />
            </div>

            <!-- Modality -->
            <div class="form-group">
                <label class="form-label">Training Modality *</label>
                <div class="card-selector-grid">
                    <div class="select-card selected" data-field="wPreference" data-value="Gym" onclick="WorkoutWizard.selectCard(this, 'wPreference', 'Gym')">
                        <div class="select-card-title">🏋️ Gym / Free Weights</div>
                        <div class="select-card-desc">Barbells, dumbbells, cables & machines (~5.8 MET)</div>
                    </div>
                    <div class="select-card" data-field="wPreference" data-value="HomeBodyweight" onclick="WorkoutWizard.selectCard(this, 'wPreference', 'HomeBodyweight')">
                        <div class="select-card-title">🤸 Home Calisthenics</div>
                        <div class="select-card-desc">Pushups, pullups, dips & bodyweight (~4.8 MET)</div>
                    </div>
                    <div class="select-card" data-field="wPreference" data-value="WalkingOnly" onclick="WorkoutWizard.selectCard(this, 'wPreference', 'WalkingOnly')">
                        <div class="select-card-title">🚶 Structured Walking</div>
                        <div class="select-card-desc">Aerobic fat oxidation & active recovery (~3.8 MET)</div>
                    </div>
                </div>
                <input type="hidden" id="wPreference" value="Gym" />
            </div>

            <!-- Frequency & Duration -->
            <div class="biometrics-row">
                <div class="form-group">
                    <label class="form-label" for="wDaysPerWeek">Training Days / Week</label>
                    <select id="wDaysPerWeek" class="form-select">
                        <option value="2">2 Days (Full Body Maintenance)</option>
                        <option value="3">3 Days (Full Body Alternating)</option>
                        <option value="4" selected>4 Days (Upper / Lower Split)</option>
                        <option value="5">5 Days (Push / Pull / Legs Split)</option>
                        <option value="6">6 Days (High Frequency Split)</option>
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label" for="wMinutesPerSession">Minutes / Session</label>
                    <select id="wMinutesPerSession" class="form-select">
                        <option value="30">30 Minutes (High Intensity Express)</option>
                        <option value="45" selected>45 Minutes (Standard Optimal)</option>
                        <option value="60">60 Minutes (Volume Focused)</option>
                        <option value="75">75 Minutes (Advanced Power)</option>
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label" for="wExperienceLevel">Experience Level</label>
                    <select id="wExperienceLevel" class="form-select">
                        <option value="Beginner" selected>Beginner (Form mastery focus)</option>
                        <option value="Intermediate">Intermediate (1-3 yrs training)</option>
                        <option value="Advanced">Advanced (3+ yrs heavy lifting)</option>
                    </select>
                </div>
            </div>

            <!-- Daily Step Goal -->
            <div class="form-group">
                <label class="form-label" for="wDailySteps">Daily Step Target (NEAT Activity)</label>
                <select id="wDailySteps" class="form-select">
                    <option value="6000">6,000 steps (~240 kcal daily burn)</option>
                    <option value="8000" selected>8,000 steps (~320 kcal daily burn)</option>
                    <option value="10000">10,000 steps (~400 kcal daily burn)</option>
                    <option value="12000">12,000 steps (~480 kcal daily burn)</option>
                </select>
            </div>

            <div class="wizard-footer">
                <button type="button" class="btn-secondary" onclick="WorkoutWizard.goToStep(1)">Back</button>
                <button type="button" class="btn-primary" onclick="WorkoutWizard.submitWorkoutPlan()">
                    <span>Generate Training Routine & Calorie Burn</span>
                    <span>➔</span>
                </button>
            </div>
        </div>

        <!-- GENERATING ANIMATION STATE -->
        <div class="wizard-step" id="workoutStepLoading" style="display: none;">
            <div class="spinner-container">
                <div class="clean-spinner"></div>
                <h3 style="font-size: 1.25rem; margin-bottom: 0.4rem;">Structuring Your Training Protocol</h3>
                <p style="font-size: 0.85rem; color: var(--text-muted);">
                    Calculating metabolic equivalent rates, volume progression, and daily energy burns...
                </p>
            </div>
        </div>

    </form>
</div>

@section Scripts {
    <script src="~/js/workout-wizard.js" asp-append-version="true"></script>
}
