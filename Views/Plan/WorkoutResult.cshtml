@model ValensFit.Models.ExercisePlanModel
@{
    var user = ViewBag.UserInput as ValensFit.Models.UserInputModel;
    var name = user?.FirstName ?? "Athlete";
    ViewData["Title"] = $"{name}'s Training Routine & Calorie Burn Analytics";
}

<div class="clean-card" id="workoutResultContainer" style="margin-bottom: 2rem;">

    <!-- Top Action Bar -->
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1.25rem;" class="no-print">
        <a href="/Plan/Workout" class="btn-secondary" style="font-size: 0.82rem; padding: 0.4rem 0.95rem; min-height: 38px;">
            <span>↺ Adjust Training Inputs</span>
        </a>
        <button type="button" class="btn-primary" onclick="window.print()" style="font-size: 0.82rem; padding: 0.45rem 1.15rem; min-height: 38px;">
            <span>Export / Print Workout Routine</span>
        </button>
    </div>

    <!-- Header & Program Title -->
    <div style="margin-bottom: 1.5rem;">
        <div style="display: inline-flex; align-items: center; gap: 0.4rem; color: var(--accent-primary); font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.35rem;">
            🏋️ Personalized Workout Architecture
        </div>
        <h1 style="font-size: 1.85rem; margin-bottom: 0.3rem; line-height: 1.2;">
            @Model.ProgramTitle for <span class="brand-accent-text">@name</span>
        </h1>
        <p style="font-size: 0.92rem; color: var(--text-secondary);">
            @Model.Rationale
        </p>
        @if (!string.IsNullOrEmpty(Model.WalkingRationale))
        {
            <div style="font-size: 0.82rem; color: var(--accent-secondary); margin-top: 0.35rem;">
                🚶 @Model.WalkingRationale
            </div>
        }
    </div>

    <!-- =================================================================
         CALORIE BURNING ANALYTICS BANNER (MET SPORTS SCIENCE EQUATIONS)
         ================================================================= -->
    <div style="background: rgba(16, 185, 129, 0.06); border: 1px solid var(--accent-border); border-radius: var(--radius-md); padding: 1.25rem; margin-bottom: 1.75rem;">
        <div style="font-size: 0.76rem; text-transform: uppercase; color: var(--accent-primary); font-weight: 700; letter-spacing: 0.05em; margin-bottom: 0.75rem;">
            ⚡ Sports-Science Calorie Burn Analytics (MET Equations)
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 0.85rem;">
            
            <div style="background: var(--bg-card); border: 1px solid var(--border-subtle); padding: 1rem 0.85rem; border-radius: var(--radius-sm); text-align: center;">
                <div style="font-size: 0.7rem; text-transform: uppercase; color: var(--text-muted); font-weight: 700;">Per-Session Burn</div>
                <div style="font-family: var(--font-heading); font-size: 1.7rem; font-weight: 800; color: var(--accent-primary); margin: 0.2rem 0;">
                    ~@Model.AvgCaloriesBurnedPerSession kcal
                </div>
                <div style="font-size: 0.72rem; color: var(--text-muted);">@Model.MinutesPerSession min session duration</div>
            </div>

            <div style="background: var(--bg-card); border: 1px solid var(--border-subtle); padding: 1rem 0.85rem; border-radius: var(--radius-sm); text-align: center;">
                <div style="font-size: 0.7rem; text-transform: uppercase; color: var(--text-muted); font-weight: 700;">Weekly Workout Burn</div>
                <div style="font-family: var(--font-heading); font-size: 1.7rem; font-weight: 800; color: var(--text-primary); margin: 0.2rem 0;">
                    ~@Model.WeeklyTotalCalorieBurn.ToString("N0") kcal
                </div>
                <div style="font-size: 0.72rem; color: var(--text-muted);">Across @Model.DaysPerWeek training days/week</div>
            </div>

            <div style="background: var(--bg-card); border: 1px solid var(--border-subtle); padding: 1rem 0.85rem; border-radius: var(--radius-sm); text-align: center;">
                <div style="font-size: 0.7rem; text-transform: uppercase; color: var(--text-muted); font-weight: 700;">Daily Step Burn (NEAT)</div>
                <div style="font-family: var(--font-heading); font-size: 1.7rem; font-weight: 800; color: var(--accent-secondary); margin: 0.2rem 0;">
                    ~@Model.DailyStepsCalorieBurn kcal
                </div>
                <div style="font-size: 0.72rem; color: var(--text-muted);">From @Model.DailyStepTarget.ToString("N0") daily step target</div>
            </div>

            <div style="background: var(--bg-card); border: 1px solid var(--border-subtle); padding: 1rem 0.85rem; border-radius: var(--radius-sm); text-align: center;">
                <div style="font-size: 0.7rem; text-transform: uppercase; color: var(--text-muted); font-weight: 700;">Modality & Split</div>
                <div style="font-family: var(--font-heading); font-size: 1.4rem; font-weight: 800; color: var(--accent-amber); margin: 0.2rem 0;">
                    @Model.Preference
                </div>
                <div style="font-size: 0.72rem; color: var(--text-muted);">@Model.DaysPerWeek Days/Week Routine</div>
            </div>

        </div>
    </div>

    <!-- =================================================================
         TRAINING SCHEDULE DAYS & EXERCISES
         ================================================================= -->
    <div style="margin-bottom: 2rem;">
        <h2 style="font-size: 1.35rem; margin-bottom: 1rem;">Structured Weekly Schedule</h2>

        @foreach (var workoutDay in Model.Schedule)
        {
            <div style="background: var(--bg-card); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: 1.25rem; margin-bottom: 1.15rem;">
                
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem; border-bottom: 1px solid var(--border-subtle); padding-bottom: 0.5rem; flex-wrap: wrap; gap: 0.4rem;">
                    <div>
                        <h3 style="font-size: 1.05rem; color: var(--text-primary);">@workoutDay.DayTitle</h3>
                        <div style="font-size: 0.78rem; color: var(--text-muted);">
                            Focus: <strong>@workoutDay.Focus</strong> · ~@workoutDay.EstimatedMinutes mins · 
                            <span style="color: var(--accent-primary);">🔥 ~@workoutDay.EstimatedCaloriesBurned kcal</span>
                        </div>
                    </div>
                    @if (workoutDay.IsRestDay)
                    {
                        <span class="budget-verdict-pill budget-verdict-fits">Active Recovery</span>
                    }
                    else
                    {
                        <span style="background: rgba(6, 182, 212, 0.12); color: var(--accent-secondary); border: 1px solid var(--accent-secondary); padding: 0.2rem 0.65rem; border-radius: var(--radius-pill); font-size: 0.74rem; font-weight: 700;">
                            @workoutDay.Exercises.Count EXERCISES
                        </span>
                    }
                </div>

                <div style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 0.75rem;">
                    <strong>Warm-Up:</strong> @workoutDay.Warmup
                </div>

                <!-- Exercise List -->
                @foreach (var ex in workoutDay.Exercises)
                {
                    <div class="workout-exercise-card">
                        <div class="workout-exercise-title">
                            <span>@ex.Name</span>
                            <span class="workout-exercise-target">@ex.TargetMuscle</span>
                        </div>
                        <div class="workout-stats-strip">
                            <span><strong>Sets:</strong> @ex.Sets</span>
                            <span><strong>Reps:</strong> @ex.Reps</span>
                            @if (ex.RestSeconds > 0)
                            {
                                <span><strong>Rest:</strong> @ex.RestSeconds sec</span>
                            }
                        </div>
                        <div class="workout-form-cue">
                            "@ex.FormCue"
                        </div>
                        @if (!string.IsNullOrEmpty(ex.Regression))
                        {
                            <div style="font-size: 0.72rem; color: var(--accent-amber); margin-top: 0.25rem;">
                                ↳ <em>Beginner Alternative:</em> @ex.Regression
                            </div>
                        }
                    </div>
                }

                <div style="font-size: 0.8rem; color: var(--text-muted); margin-top: 0.65rem;">
                    <strong>Cool-Down:</strong> @workoutDay.Cooldown
                </div>
            </div>
        }
    </div>

    <!-- Core Training Principles -->
    @if (Model.Principles.Count > 0)
    {
        <div style="background: rgba(255, 255, 255, 0.02); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); padding: 1.15rem;">
            <div style="font-size: 0.88rem; font-weight: 700; color: var(--accent-primary); margin-bottom: 0.4rem;">
                🏛️ Training Principles for Optimal Results
            </div>
            <ul style="padding-left: 1.15rem; font-size: 0.82rem; color: var(--text-secondary);">
                @foreach (var p in Model.Principles)
                {
                    <li style="margin-bottom: 0.25rem;">@p</li>
                }
            </ul>
        </div>
    }

</div>
